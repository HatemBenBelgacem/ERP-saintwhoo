# Vorlage: nach .env kopieren (cp .env.example .env) und PASSWORT ersetzen.
# PASSWORT durch das Passwort des PostgreSQL-Benutzers "postgres" ersetzen
# (wurde bei der Installation von PostgreSQL 17 festgelegt).
# Die Datenbank erp_saintwhoo wird beim ersten Start automatisch angelegt.
DATABASE_URL=postgres://postgres:PASSWORT@localhost:5432/erp_saintwhoo
