# Vorlage: nach .env kopieren (cp .env.example .env) und PASSWORT ersetzen.
# PASSWORT durch das Passwort des PostgreSQL-Benutzers "postgres" ersetzen
# (wurde bei der Installation von PostgreSQL 17 festgelegt).
# ANF-026: Zugang zum PostgreSQL-Dienst. Der Benutzer muss Datenbanken und Rollen anlegen dürfen: Der Server legt
# die Portal-Datenbank, die Rolle uniqwork_erp und je Mandant eine Datenbank uq_m_… an.
# Der Datenbankname am Ende wird nur verwendet, um daraus die Portal-Datenbank abzuleiten.
DATABASE_URL=postgres://postgres:PASSWORT@localhost:5432/uniqwork

# ANF-026: Portal-Datenbank (Registrierung, Anmeldung, Verzeichnis der Mandanten).
# Leer lassen → gleiche Verbindung wie DATABASE_URL, aber Datenbank uniqwork_portal.
# Wird beim ersten Start automatisch angelegt (Migrationen in migrations_portal/).
PORTAL_DATABASE_URL=

# ANF-007: Im Betrieb über HTTPS auf 1 setzen – dann erhält das Sitzungs-Cookie das Merkmal „Secure“.
# In der Entwicklung (http://127.0.0.1) leer lassen, sonst funktioniert die Anmeldung nicht.
SITZUNG_COOKIE_SECURE=

# ANF-008: Port, auf dem der Server hört (setzt Railway automatisch). Gesetzt → 0.0.0.0:<PORT>,
# leer → site-addr aus Cargo.toml (127.0.0.1:3002). In der Entwicklung leer lassen.
PORT=
